<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

<title>Orbital Drift — Chuli</title>

<style>

  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap');

  :root{
    --bg: #0B0E1A;
    --bg-deep: #05060C;
    --amber: #FFB347;
    --cyan: #4DD9E8;
    --violet: #8B7FD9;
    --ink: #EAEAF2;
    --ink-dim: #7C819A;

    --display: 'Space Grotesk', sans-serif;
    --mono: 'JetBrains Mono', monospace;
  }


  * {
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
  }


  html,
  body {
    margin: 0;
    padding: 0;

    width: 100%;
    height: 100%;

    background:
      radial-gradient(
        ellipse at 50% 40%,
        var(--bg) 0%,
        var(--bg-deep) 100%
      );

    overflow: hidden;

    font-family: var(--mono);
    color: var(--ink);

    user-select: none;
    -webkit-user-select: none;

    overscroll-behavior: none;
  }


  #wrap {
    position: relative;

    width: 100vw;
    height: 100vh;

    touch-action: none;
  }


  canvas {
    display: block;

    width: 100%;
    height: 100%;

    touch-action: none;

    cursor: pointer;
  }


  /* ================================
     HUD
  ================================= */

  .hud {
    position: absolute;

    top: 22px;
    left: 24px;

    pointer-events: none;

    z-index: 5;
  }


  .hud .label {
    font-size: 10px;

    letter-spacing: 0.18em;

    color: var(--ink-dim);

    text-transform: uppercase;
  }


  .hud .score {
    font-family: var(--display);

    font-size: 40px;

    font-weight: 700;

    line-height: 1.05;

    color: var(--ink);

    text-shadow:
      0 0 18px rgba(255,179,71,0.25);
  }


  .hud .best {
    margin-top: 6px;

    font-size: 11px;

    color: var(--ink-dim);

    letter-spacing: 0.08em;
  }


  .hud .best b {
    color: var(--cyan);

    font-weight: 500;
  }


  /* ================================
     CREDIT
  ================================= */

  .credit {
    position: absolute;

    bottom: 16px;
    right: 20px;

    font-size: 10px;

    letter-spacing: 0.14em;

    color: var(--ink-dim);

    text-transform: uppercase;

    z-index: 5;

    pointer-events: none;
  }


  .credit b {
    color: var(--amber);

    font-weight: 500;
  }


  /* ================================
     LANE HINT
  ================================= */

  .lane-hint {
    position: absolute;

    bottom: 16px;
    left: 24px;

    font-size: 10px;

    letter-spacing: 0.1em;

    color: var(--ink-dim);

    text-transform: uppercase;

    z-index: 5;

    pointer-events: none;

    opacity: 0.7;
  }


  /* ================================
     OVERLAY
  ================================= */

  .overlay {
    position: absolute;

    inset: 0;

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    text-align: center;

    z-index: 10;

    background:
      radial-gradient(
        ellipse at 50% 45%,
        rgba(11,14,26,0.2) 0%,
        rgba(5,6,12,0.72) 75%
      );

    transition: opacity 0.35s ease;

    -webkit-tap-highlight-color: transparent;

    touch-action: manipulation;
  }


  .overlay.hidden {
    opacity: 0;

    pointer-events: none;
  }


  /* ================================
     TITLE
  ================================= */

  .title {
    font-family: var(--display);

    font-weight: 700;

    font-size: clamp(34px, 8vw, 62px);

    letter-spacing: 0.01em;

    margin: 0;

    background:
      linear-gradient(
        180deg,
        #FFFFFF 0%,
        var(--amber) 120%
      );

    -webkit-background-clip: text;

    background-clip: text;

    color: transparent;
  }


  .subtitle {
    font-family: var(--mono);

    font-size: 12px;

    letter-spacing: 0.16em;

    color: var(--ink-dim);

    text-transform: uppercase;

    margin-top: 10px;
  }


  /* ================================
     RESULT
  ================================= */

  .result-score {
    font-family: var(--display);

    font-weight: 700;

    font-size: clamp(48px, 12vw, 90px);

    color: var(--ink);

    margin: 18px 0 2px 0;

    text-shadow:
      0 0 30px rgba(77,217,232,0.35);
  }


  .result-label {
    font-size: 10px;

    letter-spacing: 0.2em;

    color: var(--ink-dim);

    text-transform: uppercase;
  }


  .result-best {
    margin-top: 14px;

    font-size: 12px;

    color: var(--ink-dim);

    letter-spacing: 0.08em;
  }


  .result-best b {
    color: var(--cyan);

    font-weight: 500;
  }


  /* ================================
     PROMPT
  ================================= */

  .prompt {
    margin-top: 34px;

    font-family: var(--mono);

    font-size: 11px;

    letter-spacing: 0.14em;

    color: var(--ink);

    text-transform: uppercase;

    padding: 12px 26px;

    border:
      1px solid rgba(234,234,242,0.25);

    border-radius: 999px;

    animation:
      pulse-btn 2.2s ease-in-out infinite;
  }


  @keyframes pulse-btn {

    0%,
    100% {
      border-color:
        rgba(234,234,242,0.25);

      box-shadow:
        0 0 0 rgba(255,179,71,0);
    }

    50% {
      border-color:
        rgba(255,179,71,0.6);

      box-shadow:
        0 0 18px rgba(255,179,71,0.15);
    }

  }


  /* ================================
     CONTROLS
  ================================= */

  .controls-diagram {
    display: flex;

    gap: 22px;

    margin-top: 30px;

    font-size: 10px;

    letter-spacing: 0.08em;

    color: var(--ink-dim);

    text-transform: uppercase;
  }


  .controls-diagram span b {
    color: var(--ink);

    font-weight: 500;
  }


  /* ================================
     MOBILE
  ================================= */

  @media (max-width: 600px) {

    .hud {
      top: 16px;
      left: 18px;
    }

    .hud .score {
      font-size: 34px;
    }

    .lane-hint {
      bottom: 14px;
      left: 18px;
      font-size: 9px;
    }

    .credit {
      bottom: 14px;
      right: 18px;
      font-size: 8px;
    }

    .controls-diagram {
      flex-direction: column;
      gap: 8px;
      margin-top: 24px;
    }

    .subtitle {
      font-size: 10px;
      padding: 0 20px;
    }

    .prompt {
      font-size: 10px;
      padding: 12px 20px;
    }

  }


  @media (prefers-reduced-motion: reduce) {

    .prompt {
      animation: none;
    }

  }

</style>

</head>


<body>


<div id="wrap">

  <canvas id="game"></canvas>


  <div class="hud">

    <div class="label">
      Signal Time
    </div>

    <div
      class="score"
      id="scoreDisplay"
    >
      0
    </div>

    <div class="best">

      Best

      <b id="bestDisplay">
        0
      </b>

    </div>

  </div>


  <div
    class="lane-hint"
    id="laneHint"
  >
    ◀ inward&nbsp;&nbsp;&nbsp;outward ▶
  </div>


  <div class="credit">

    Portfolio piece —

    <b>
      Chuli
    </b>

  </div>


  <!-- START SCREEN -->

  <div
    class="overlay"
    id="startScreen"
  >

    <h1 class="title">
      ORBITAL&nbsp;DRIFT
    </h1>

    <div class="subtitle">
      Hold your lane. Dodge the sweep.
    </div>


    <div class="controls-diagram">

      <span>
        <b>Tap left</b>
        — move in
      </span>

      <span>
        <b>Tap right</b>
        — move out
      </span>

    </div>


    <div
      class="prompt"
      id="startPrompt"
    >
      Tap or press space to begin
    </div>

  </div>


  <!-- GAME OVER SCREEN -->

  <div
    class="overlay hidden"
    id="gameOverScreen"
  >

    <div class="result-label">
      Signal Lost
    </div>


    <div
      class="result-score"
      id="finalScore"
    >
      0
    </div>


    <div
      class="result-best"
      id="finalBest"
    >
      Best <b>0</b>
    </div>


    <div class="prompt">
      Tap or press space to try again
    </div>

  </div>


</div>


<script>

(function(){

  "use strict";


  /* =========================================
     SETUP
  ========================================= */

  const canvas =
    document.getElementById('game');

  const ctx =
    canvas.getContext('2d');


  const scoreDisplay =
    document.getElementById('scoreDisplay');

  const bestDisplay =
    document.getElementById('bestDisplay');

  const startScreen =
    document.getElementById('startScreen');

  const gameOverScreen =
    document.getElementById('gameOverScreen');

  const finalScore =
    document.getElementById('finalScore');

  const finalBest =
    document.getElementById('finalBest');

  const laneHint =
    document.getElementById('laneHint');


  let dpr =
    Math.min(
      window.devicePixelRatio || 1,
      2
    );


  let W = 0;
  let H = 0;

  let cx = 0;
  let cy = 0;


  /* =========================================
     RESIZE
  ========================================= */

  function resize(){

    W = window.innerWidth;
    H = window.innerHeight;


    dpr =
      Math.min(
        window.devicePixelRatio || 1,
        2
      );


    canvas.width =
      W * dpr;

    canvas.height =
      H * dpr;


    canvas.style.width =
      W + 'px';

    canvas.style.height =
      H + 'px';


    ctx.setTransform(
      dpr,
      0,
      0,
      dpr,
      0,
      0
    );


    cx = W / 2;
    cy = H / 2;


    computeLaneRadii();


    if (
      state !== 'playing' &&
      player
    ){

      player.displayRadius =
        laneRadii[player.lane];

    }

  }


  /* =========================================
     PERSISTENCE
  ========================================= */

  let bestScore = 0;


  (function loadBest(){

    try {

      const v =
        localStorage.getItem(
          'chuli_orbital_drift_best'
        );


      if (v) {

        bestScore =
          parseInt(v, 10) || 0;

      }

    } catch(e) {

      /* storage unavailable */

    }


    bestDisplay.textContent =
      bestScore;

  })();


  function saveBest(v){

    bestScore = v;

    bestDisplay.textContent =
      bestScore;


    try {

      localStorage.setItem(
        'chuli_orbital_drift_best',
        String(v)
      );

    } catch(e) {

      /* ignore */

    }

  }


  /* =========================================
     GAME CONSTANTS
  ========================================= */

  const LANE_COUNT = 3;

  let laneRadii = [];


  const TOP_ANGLE =
    -Math.PI / 2;


  const TWO_PI =
    Math.PI * 2;


  function computeLaneRadii(){

    const maxR =
      Math.min(W, H) * 0.38;


    const minR =
      Math.min(W, H) * 0.16;


    laneRadii = [];


    for (
      let i = 0;
      i < LANE_COUNT;
      i++
    ){

      laneRadii.push(
        minR +
        (maxR - minR) *
        (i / (LANE_COUNT - 1))
      );

    }

  }


  /* =========================================
     STATE
  ========================================= */

  let state = 'start';


  let player = {
    lane: 1,
    displayRadius: 0
  };


  let obstacles = [];

  let particles = [];

  let stars = [];


  let elapsed = 0;

  let spawnTimer = 0;

  let lastTime = 0;

  let score = 0;

  let coreBreath = 0;

  let shakeT = 0;


  /* =========================================
     STARS
  ========================================= */

  function initStars(){

    stars = [];


    const count =
      Math.floor(
        (W * H) / 9000
      );


    for (
      let i = 0;
      i < count;
      i++
    ){

      stars.push({

        x:
          Math.random() * W,

        y:
          Math.random() * H,

        r:
          Math.random() * 1.3 + 0.2,

        tw:
          Math.random() * TWO_PI,

        speed:
          0.5 +
          Math.random() * 1.2

      });

    }

  }


  /* =========================================
     RESET GAME
  ========================================= */

  function resetGame(){

    player.lane = 1;

    player.displayRadius =
      laneRadii[1];


    obstacles = [];

    particles = [];


    elapsed = 0;

    spawnTimer = 0;

    score = 0;


    scoreDisplay.textContent =
      '0';

  }


  /* =========================================
     SPAWN OBSTACLE
  ========================================= */

  function spawnObstacle(){

    const difficulty =
      Math.min(
        elapsed / 45,
        1
      );


    const lane =
      Math.floor(
        Math.random() * LANE_COUNT
      );


    const dir =
      Math.random() < 0.5
        ? 1
        : -1;


    const baseSpeed =
      0.9 +
      difficulty * 1.3;


    const speed =
      dir *
      (
        baseSpeed +
        Math.random() * 0.4
      );


    const width =
      (
        0.62 -
        difficulty * 0.22
      ) *
      (
        0.85 +
        Math.random() * 0.3
      );


    const startAngle =
      TOP_ANGLE +
      Math.PI +
      (
        Math.random() - 0.5
      ) * 0.6;


    const colors = [
      '#4DD9E8',
      '#8B7FD9'
    ];


    obstacles.push({

      lane,

      angle:
        startAngle,

      speed,

      width,

      color:
        colors[
          Math.floor(
            Math.random() *
            colors.length
          )
        ],

      spawnAngle:
        startAngle,

      totalRot: 0,

      passed: false

    });

  }


  /* =========================================
     PARTICLES
  ========================================= */

  function emitTrail(
    x,
    y,
    color,
    count
  ){

    for (
      let i = 0;
      i < count;
      i++
    ){

      particles.push({

        x,

        y,

        vx:
          (
            Math.random() - 0.5
          ) * 2.2,

        vy:
          (
            Math.random() - 0.5
          ) * 2.2,

        life: 1,

        color

      });

    }

  }


  /* =========================================
     ANGLE DIFFERENCE
  ========================================= */

  function angleDiff(a, b){

    let d =
      (a - b) % TWO_PI;


    if (d > Math.PI)
      d -= TWO_PI;


    if (d < -Math.PI)
      d += TWO_PI;


    return d;

  }


  /* =========================================
     CHANGE LANE
  ========================================= */

  function changeLane(dir){

    if (state !== 'playing')
      return;


    const newLane =
      Math.max(
        0,
        Math.min(
          LANE_COUNT - 1,
          player.lane + dir
        )
      );


    if (
      newLane !==
      player.lane
    ){

      player.lane =
        newLane;


      const px =
        cx +
        Math.cos(TOP_ANGLE) *
        player.displayRadius;


      const py =
        cy +
        Math.sin(TOP_ANGLE) *
        player.displayRadius;


      emitTrail(
        px,
        py,
        '#FFB347',
        14
      );

    }

  }


  /* =========================================
     INPUT
     ========================================= */

  function handlePrimaryInput(
    clientX
  ){

    if (
      state === 'start' ||
      state === 'over'
    ){

      startGame();

      return;

    }


    if (clientX < W / 2){

      changeLane(-1);

    } else {

      changeLane(1);

    }

  }


  /*
    MOBILE TOUCH FIX

    We use touchstart directly because
    some mobile browsers do not reliably
    trigger pointerdown for this type of
    fullscreen canvas game.
  */

  let lastTouchTime = 0;


  window.addEventListener(
    'touchstart',
    function(e){

      if (
        !e.touches ||
        !e.touches.length
      ){

        return;

      }


      e.preventDefault();


      const touch =
        e.touches[0];


      lastTouchTime =
        Date.now();


      handlePrimaryInput(
        touch.clientX
      );

    },
    {
      passive: false
    }
  );


  /*
    POINTER SUPPORT

    This keeps desktop and modern
    browsers working.
  */

  window.addEventListener(
    'pointerdown',
    function(e){

      /*
        Prevent the same touch from being
        processed twice by both touchstart
        and pointerdown.
      */

      if (
        Date.now() -
        lastTouchTime <
        500
      ){

        return;

      }


      handlePrimaryInput(
        e.clientX
      );

    },
    {
      passive: true
    }
  );


  /*
    MOUSE SUPPORT

    Explicit mouse support for desktop.
  */

  window.addEventListener(
    'mousedown',
    function(e){

      /*
        Ignore mouse events that are
        generated from a mobile touch.
      */

      if (
        Date.now() -
        lastTouchTime <
        500
      ){

        return;

      }


      handlePrimaryInput(
        e.clientX
      );

    }
  );


  /*
    KEYBOARD SUPPORT
  */

  window.addEventListener(
    'keydown',
    function(e){

      if (
        e.code === 'Space' ||
        e.key === ' '
      ){

        e.preventDefault();


        if (
          state === 'start' ||
          state === 'over'
        ){

          startGame();

        }

        return;

      }


      if (
        state !== 'playing'
      ){

        return;

      }


      if (
        e.code === 'ArrowLeft' ||
        e.code === 'ArrowDown'
      ){

        changeLane(-1);

      }


      if (
        e.code === 'ArrowRight' ||
        e.code === 'ArrowUp'
      ){

        changeLane(1);

      }

    }
  );


  /* =========================================
     RESIZE EVENTS
  ========================================= */

  window.addEventListener(
    'resize',
    resize
  );


  window.addEventListener(
    'resize',
    initStars
  );


  /* =========================================
     START GAME
  ========================================= */

  function startGame(){

    resetGame();


    state =
      'playing';


    startScreen.classList.add(
      'hidden'
    );


    gameOverScreen.classList.add(
      'hidden'
    );


    laneHint.style.opacity =
      '0.7';

  }


  /* =========================================
     END GAME
  ========================================= */

  function endGame(){

    state =
      'over';


    const finalS =
      Math.floor(score);


    finalScore.textContent =
      finalS;


    if (
      finalS >
      bestScore
    ){

      saveBest(finalS);


      finalBest.innerHTML =
        'New Best <b>' +
        finalS +
        '</b>';

    } else {

      finalBest.innerHTML =
        'Best <b>' +
        bestScore +
        '</b>';

    }


    gameOverScreen.classList.remove(
      'hidden'
    );


    shakeT =
      0.35;

  }


  /* =========================================
     UPDATE
  ========================================= */

  function update(dt){

    coreBreath += dt;


    if (
      state !== 'playing'
    ){

      updateParticles(dt);

      return;

    }


    elapsed += dt;


    score +=
      dt * 10;


    scoreDisplay.textContent =
      Math.floor(score);


    /*
      Smooth radius interpolation
    */

    const target =
      laneRadii[player.lane];


    player.displayRadius +=
      (
        target -
        player.displayRadius
      ) *
      Math.min(
        1,
        dt * 12
      );


    /*
      Spawn logic
    */

    const difficulty =
      Math.min(
        elapsed / 45,
        1
      );


    const spawnInterval =
      1.15 -
      difficulty * 0.65;


    spawnTimer += dt;


    if (
      spawnTimer >
      spawnInterval
    ){

      spawnTimer = 0;

      spawnObstacle();

    }


    /*
      Update obstacles
    */

    for (
      let i =
        obstacles.length - 1;
      i >= 0;
      i--
    ){

      const o =
        obstacles[i];


      o.angle +=
        o.speed * dt;


      o.totalRot +=
        Math.abs(
          o.speed * dt
        );


      /*
        Collision check
      */

      if (
        o.lane ===
        player.lane
      ){

        const d =
          Math.abs(
            angleDiff(
              o.angle,
              TOP_ANGLE
            )
          );


        if (
          d <
          o.width / 2 +
          0.045
        ){

          endGame();

        }

      }


      /*
        Remove obstacle
      */

      if (
        o.totalRot >
        TWO_PI + 0.3
      ){

        obstacles.splice(
          i,
          1
        );

      }

    }


    updateParticles(dt);


    /*
      Ambient player trail
    */

    if (
      Math.random() < 0.55
    ){

      const px =
        cx +
        Math.cos(TOP_ANGLE) *
        player.displayRadius;


      const py =
        cy +
        Math.sin(TOP_ANGLE) *
        player.displayRadius;


      emitTrail(
        px,
        py,
        '#FFB347',
        1
      );

    }

  }


  /* =========================================
     UPDATE PARTICLES
  ========================================= */

  function updateParticles(dt){

    for (
      let i =
        particles.length - 1;
      i >= 0;
      i--
    ){

      const p =
        particles[i];


      p.x += p.vx;

      p.y += p.vy;


      p.life -=
        dt * 1.8;


      if (
        p.life <= 0
      ){

        particles.splice(
          i,
          1
        );

      }

    }


    if (
      shakeT > 0
    ){

      shakeT -= dt;

    }

  }


  /* =========================================
     DRAW
  ========================================= */

  function draw(){

    ctx.clearRect(
      0,
      0,
      W,
      H
    );


    /*
      Background
    */

    const grad =
      ctx.createRadialGradient(
        cx,
        cy,
        0,
        cx,
        cy,
        Math.max(W,H) * 0.7
      );


    grad.addColorStop(
      0,
      '#0F1224'
    );


    grad.addColorStop(
      1,
      '#05060C'
    );


    ctx.fillStyle =
      grad;


    ctx.fillRect(
      0,
      0,
      W,
      H
    );


    /*
      Stars
    */

    for (
      const s of stars
    ){

      const tw =
        0.5 +
        0.5 *
        Math.sin(
          coreBreath *
          s.speed +
          s.tw
        );


      ctx.globalAlpha =
        0.25 +
        tw * 0.45;


      ctx.fillStyle =
        '#EAEAF2';


      ctx.beginPath();


      ctx.arc(
        s.x,
        s.y,
        s.r,
        0,
        TWO_PI
      );


      ctx.fill();

    }


    ctx.globalAlpha =
      1;


    /*
      Screen shake
    */

    let ox = 0;
    let oy = 0;


    if (
      shakeT > 0
    ){

      ox =
        (
          Math.random() -
          0.5
        ) *
        8 *
        shakeT;


      oy =
        (
          Math.random() -
          0.5
        ) *
        8 *
        shakeT;

    }


    ctx.save();


    ctx.translate(
      ox,
      oy
    );


    /*
      Lane rings
    */

    for (
      let i = 0;
      i < LANE_COUNT;
      i++
    ){

      ctx.beginPath();


      ctx.arc(
        cx,
        cy,
        laneRadii[i],
        0,
        TWO_PI
      );


      ctx.strokeStyle =
        'rgba(234,234,242,0.08)';


      ctx.lineWidth =
        1;


      ctx.stroke();

    }


    /*
      Pulsing core
    */

    const breathe =
      1 +
      Math.sin(
        coreBreath * 1.6
      ) *
      0.06;


    const coreR =
      Math.min(W,H) *
      0.05 *
      breathe;


    const coreGrad =
      ctx.createRadialGradient(
        cx,
        cy,
        0,
        cx,
        cy,
        coreR * 2.4
      );


    coreGrad.addColorStop(
      0,
      'rgba(255,179,71,0.9)'
    );


    coreGrad.addColorStop(
      0.4,
      'rgba(255,179,71,0.25)'
    );


    coreGrad.addColorStop(
      1,
      'rgba(255,179,71,0)'
    );


    ctx.fillStyle =
      coreGrad;


    ctx.beginPath();


    ctx.arc(
      cx,
      cy,
      coreR * 2.4,
      0,
      TWO_PI
    );


    ctx.fill();


    ctx.fillStyle =
      '#FFE3BB';


    ctx.beginPath();


    ctx.arc(
      cx,
      cy,
      coreR * 0.55,
      0,
      TWO_PI
    );


    ctx.fill();


    /*
      Obstacles
    */

    for (
      const o of obstacles
    ){

      const r =
        laneRadii[o.lane];


      ctx.beginPath();


      ctx.arc(
        cx,
        cy,
        r,
        o.angle -
        o.width / 2,
        o.angle +
        o.width / 2
      );


      ctx.strokeStyle =
        o.color;


      ctx.lineWidth =
        6;


      ctx.lineCap =
        'round';


      ctx.shadowColor =
        o.color;


      ctx.shadowBlur =
        14;


      ctx.stroke();


      ctx.shadowBlur =
        0;

    }


    /*
      Top danger marker
    */

    ctx.beginPath();


    ctx.moveTo(
      cx,
      cy -
      laneRadii[0] +
      10
    );


    ctx.lineTo(
      cx,
      cy -
      laneRadii[
        LANE_COUNT - 1
      ] -
      14
    );


    ctx.strokeStyle =
      'rgba(234,234,242,0.12)';


    ctx.lineWidth =
      1;


    ctx.setLineDash([
      2,
      5
    ]);


    ctx.stroke();


    ctx.setLineDash([]);


    /*
      Particles
    */

    for (
      const p of particles
    ){

      ctx.globalAlpha =
        Math.max(
          0,
          p.life
        );


      ctx.fillStyle =
        p.color;


      ctx.beginPath();


      ctx.arc(
        p.x,
        p.y,
        2.4,
        0,
        TWO_PI
      );


      ctx.fill();

    }


    ctx.globalAlpha =
      1;


    /*
      Player
    */

    const pr =
      player.displayRadius ||
      laneRadii[1];


    const px =
      cx +
      Math.cos(TOP_ANGLE) *
      pr;


    const py =
      cy +
      Math.sin(TOP_ANGLE) *
      pr;


    /*
      Player glow
    */

    ctx.beginPath();


    ctx.arc(
      px,
      py,
      9,
      0,
      TWO_PI
    );


    ctx.fillStyle =
      'rgba(255,179,71,0.25)';


    ctx.shadowColor =
      '#FFB347';


    ctx.shadowBlur =
      22;


    ctx.fill();


    /*
      Player core
    */

    ctx.beginPath();


    ctx.arc(
      px,
      py,
      5.5,
      0,
      TWO_PI
    );


    ctx.fillStyle =
      '#FFB347';


    ctx.shadowBlur =
      8;


    ctx.fill();


    ctx.shadowBlur =
      0;


    ctx.restore();

  }


  /* =========================================
     GAME LOOP
  ========================================= */

  function loop(ts){

    if (!lastTime)
      lastTime = ts;


    const dt =
      Math.min(
        (
          ts -
          lastTime
        ) / 1000,
        0.05
      );


    lastTime =
      ts;


    update(dt);

    draw();


    requestAnimationFrame(
      loop
    );

  }


  /* =========================================
     INITIALIZE
  ========================================= */

  resize();

  initStars();


  player.displayRadius =
    laneRadii[1];


  requestAnimationFrame(
    loop
  );


})();

</script>


